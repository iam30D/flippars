{
  "name": "flippars",
  "version": "0.1.0",
  "private": true,
  "description": "Auditable, abstention-first Bitcoin market signal platform.",
  "engines": {
    "node": ">=20.19 <21"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  },
  "scripts": {
    "build": "npm run build:shared && npm run build --workspace @flippars/model-lab && npm run build --workspace @flippars/api && npm run build --workspace @flippars/mobile",
    "build:shared": "npm run build --workspace @flippars/contracts && npm run build --workspace @flippars/signal-core && npm run build --workspace @flippars/model-artifact",
    "clean": "npm run clean --workspaces --if-present",
    "dev:api": "npm run dev --workspace @flippars/api",
    "dev:mobile": "npm run start --workspace @flippars/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run build:shared && eslint . --max-warnings=0",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "repo:check": "node scripts/check-repository.mjs",
    "model:review": "node scripts/review-model-evaluation.mjs",
    "capture:market": "node --import tsx apps/api/src/research/capture-cli.ts",
    "capture:market:long": "node --import tsx apps/api/src/research/capture-long-cli.ts",
    "capture:market:observed": "node --import tsx apps/api/src/research/capture-observed-cli.ts",
    "capture:market:isolated": "node --import tsx apps/api/src/research/capture-isolated-cli.ts",
    "capture:verify": "node --import tsx apps/api/src/research/capture-verifier.ts",
    "research:audit-capture": "node --import tsx apps/api/src/research/capture-decision-audit.ts",
    "research:audit-quality": "node --import tsx apps/api/src/research/capture-quality-audit.ts",
    "research:replay-capture": "node --import tsx apps/api/src/research/population-replay-cli.ts",
    "test:model-review": "node --test scripts/review-model-evaluation.test.mjs",
    "verify": "npm run repo:check && npm run format:check && npm run lint && npm run typecheck && npm run test:model-review && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
