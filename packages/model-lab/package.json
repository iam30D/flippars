{
  "name": "@flippars/model-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Chronological, draft-only challenger training and calibration for Flippars.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "flippars-model-lab": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -p tsconfig.json --build --clean",
    "test": "npm run build && node --test dist/training.test.js",
    "train": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flippars/contracts": "0.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
