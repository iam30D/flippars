{
  "name": "@flippars/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "env:check:production": "tsx src/check-production-environment.ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/src/db/migrate.js",
    "retention": "tsx src/db/retention-cli.ts",
    "retention:prod": "node dist/src/db/retention-cli.js",
    "test": "node --import tsx --test test/api.test.ts test/config.test.ts test/retention.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flippars/contracts": "0.1.0",
    "@flippars/signal-core": "0.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "pg": "^8.13.3",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
