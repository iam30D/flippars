# Copy only for local validation. In production, inject these values through
# your cloud secret manager and runtime configuration instead of shipping a file.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Secret. Replace every uppercase placeholder. Keep the encryption key stable.
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/flippars
DATABASE_SSL=true
DATABASE_CA_CERT=
DEVICE_TOKEN_ENCRYPTION_KEY=REPLACE_ME

# Native iOS requests do not send Origin. Add exact HTTPS browser origins only
# if you later deploy a browser client.
CORS_ORIGINS=
TRUST_PROXY=false
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

MARKET_FEEDS=coinbase,kraken,binance
MARKET_STALE_AFTER_MS=5000
MARKET_MIN_HEALTHY_VENUES=3
MARKET_MAX_USDT_DEVIATION_BPS=50
MARKET_OBSERVATION_RETENTION_DAYS=30
REQUIRE_MARKET_FOR_READINESS=false
SIMULATED_FEED_ENABLED=false

# No validated live model provider is bundled. The application refuses to
# start with signals enabled until that changes through the governed workflow.
SIGNALS_ENABLED=false
MODEL_PROVIDER=disabled
SIGNAL_CONFIDENCE_THRESHOLD=0.75
SIGNAL_MIN_LEAD_TIME_MS=5000
SIGNAL_NEUTRAL_BAND_BPS=1

# Leave APNs disabled until a physical-device TestFlight test passes. When you
# enable it, fill every APNs value and keep APNS_ENVIRONMENT=production.
APNS_ENABLED=false
APNS_ENVIRONMENT=production
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.flippars.mobile
APNS_PRIVATE_KEY=
