# Public values are embedded in the app bundle. Never put secrets here.
# Production mode never falls back to demo data.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_DEMO_MODE=false

# Associates this project with EAS builds and native APNs credentials.
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# eas.json supplies this automatically for cloud builds. Set it only when
# validating a profile locally.
FLIPPARS_BUILD_PROFILE=development
